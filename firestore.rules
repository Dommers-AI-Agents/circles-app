rules_version = '2';

// No client reads or writes Firestore directly: the iOS app, App Clip,
// extensions, website and MCP server all go through the backend API, which
// uses the Admin SDK (rules don't apply to it). The previous rules allowed
// client access nothing needed (any signed-in user could read every
// suggestion and comment, and update their own user doc's fields freely).
// Deny everything to clients (security audit 2026-10-01).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
