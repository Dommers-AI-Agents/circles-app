{
  "name": "favcircles-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FavCircles in a browser (app.favcircles.com), for phones with no iOS app. Built into backend/public/app, which the backend serves.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && node scripts/stamp-build.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
