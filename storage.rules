rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the content
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to validate image uploads
    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024 && // Max 10MB
             request.resource.contentType.matches('image/.*');
    }
    
    // Helper function to validate video uploads  
    function isValidVideo() {
      return request.resource.size < 100 * 1024 * 1024 && // Max 100MB
             (request.resource.contentType.matches('video/.*') || 
              request.resource.contentType == 'application/octet-stream');
    }
    
    // Security audit 2026-10-01:
    // - Public paths are `get` only (fetch a file whose URL you were given).
    //   `read` also granted `list`, which let anyone enumerate every upload —
    //   including the media of private moments and places.
    // - The app never writes here directly (uploads go through the backend's
    //   admin SDK or signed URLs, which bypass these rules), so client writes
    //   are create-only, size/type-checked, and scoped to the uploader's own
    //   folder wherever the path carries a uid. Nobody can overwrite or delete
    //   someone else's file.

    // Profile images - public by URL (profile pictures are visible to all)
    match /profiles/{userId}/{allPaths=**} {
      allow get: if true;
      allow write: if isOwner(userId) && isValidImage();
    }
    
    // Circle content - public by URL (includes misplaced profile images).
    // No uid in the path, so: signed in, create only, image/video checked.
    match /circles/{circleId}/{allPaths=**} {
      allow get: if true;
      allow create: if isAuthenticated() && (isValidImage() || isValidVideo());
    }
    
    // Place photos - public by URL (place images are shareable).
    // No uid in the path, so: signed in, create only, image checked.
    match /places/{placeId}/{allPaths=**} {
      allow get: if true;
      allow create: if isAuthenticated() && isValidImage();
    }
    
    // Moment media: videos/{uid}/{full|preview|thumbnails}/... The stored
    // video/thumbnail URLs are tokenless `?alt=media`, so public `get` must
    // stay. The old catch-all `match /videos/{videoId}/{allPaths=**}` block
    // overlapped this one and let ANY signed-in user write into anyone's
    // folder (overlapping matches grant if any allows) — removed; reads of
    // two-segment paths are covered by the get below.
    match /videos/{userId}/{allPaths=**} {
      allow get: if true;
      allow write: if isOwner(userId) && (isValidVideo() || isValidImage());
    }
    
    // User moments/reels - public by URL, owner can write
    match /moments/{userId}/{allPaths=**} {
      allow get: if true;
      allow write: if isOwner(userId) && (isValidImage() || isValidVideo());
    }
    
    // Tutorial videos - public by URL
    match /tutorial/{allPaths=**} {
      allow get: if true;
      allow write: if false; // No writes allowed (admin upload only)
    }
    
    // Temporary uploads - authenticated users only
    match /temp/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}