# Cache policy: HTML always revalidates (the site iterates often and stale
# pages kept serving old layouts); media can cache for a day.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(mp4|mov|jpg|jpeg|png|gif|ico|pdf|tiff)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# Digital postcards (Widgets tab → Postcard): friendly share links live on
# favcircles.com, the page itself is served by the API. Previews and
# browsers follow the redirect.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^postcard/([A-Za-z0-9_-]+)/?$ https://api.favcircles.com/postcard/$1 [R=302,L]
  RewriteRule ^postcard/([A-Za-z0-9_-]+)/(image|download)$ https://api.favcircles.com/postcard/$1/$2 [R=302,L]
</IfModule>
